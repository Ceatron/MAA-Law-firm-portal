# ==============================================================================
# Muthoni Ahago Advocates Web Portal - Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to create your local `.env` file:
#      cp .env.example .env
# 2. Populate the required values below.
# 3. Restart the development server after modifying `.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI Configuration (Server-Side Only)
# ------------------------------------------------------------------------------
# Gemini API Key for server-side legal document summarization and Wakili AI assistant.
# Kept server-side to prevent API key exposure in client bundles.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Supabase Client Configuration (Frontend Safe)
# ------------------------------------------------------------------------------
# Must be added to your `.env` file.
# The 'VITE_' prefix exposes these variables to the browser/client-side application.
# 
# - VITE_SUPABASE_URL: Your Supabase project URL (e.g., https://your-project.supabase.co)
# - VITE_SUPABASE_ANON_KEY: The public anonymous key. Safe for client-side use
#   because all operations are protected by Supabase Row Level Security (RLS) policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. Supabase Administrative Configuration (CRITICAL: Server-Side ONLY)
# ------------------------------------------------------------------------------
# SECURITY WARNING:
# - The service-role key (SUPABASE_SERVICE_ROLE_KEY) has admin superuser privileges
#   and BYPASSES all Row Level Security (RLS) policies.
# - It must remain EXCLUSIVELY on the server-side (Node.js/server.ts/API routes).
# - NEVER prefix the service-role key with 'VITE_'.
# - NEVER import or reference the service-role key in any frontend service,
#   React component, or client-side module.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

